; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Fifi's Forest"
config/description="An atmospheric WebXR-to-native VR port for Meta Quest, built with Godot + OpenXR."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]

window/stretch/mode="disabled"
window/handheld/orientation="landscape"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[xr]

openxr/enabled=true
openxr/foveation_level=2
openxr/foveation_dynamic=true
shaders/enabled=true
